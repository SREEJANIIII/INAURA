# INAURA Backend — Environment Variables
# Copy to .env and fill with real values. Never commit .env

# Supabase — get these from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: JWT secret for local verification (from Supabase Auth settings)
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# API
API_V1_PREFIX=/api/v1

# Embeddings — Gemini (recommended), optional
# If not set, RAG falls back to deterministic keyword retrieval and app still starts.
# RAG pipeline: Gemini embeddings (768-d) → Supabase pgvector (HNSW) → retrieval_service
# Get a key at https://aistudio.google.com/apikey (same key as GOOGLE_API_KEY)
# Models: gemini-embedding-001 (768-d via outputDimensionality, default), text-embedding-004 (768-d, deprecated Jan 2026)
# Existing 1536-d OpenAI vectors MUST be re-embedded after switching providers (see supabase/016 migration + scripts/reembed_industry_knowledge.py)
# Example: EMBEDDING_PROVIDER=gemini, EMBEDDING_API_KEY=<Google API key>, EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_MODEL=gemini-embedding-001
# Optional: override output dimensionality (must match DB vector(768)). Default 768 via embedding_service.DIMENSION
# EMBEDDING_DIMENSION=768

# Experimental AI review (/ai-review-test only) — optional
# Get a key at https://aistudio.google.com/apikey. Never commit real values.
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- LOCAL LLM for interview (active) ---------------------------------------
# User requested local LLM at http://localhost:1234/api/v1/chat for AI interview.
# This is the ONLY LLM used for interview evaluation now. RAG/Embeddings stay on Gemini.
LOCAL_LLM_URL=http://localhost:1234/api/v1/chat
LOCAL_LLM_MODEL=local-model
# LOCAL_LLM_API_KEY=  # only if your local server requires auth

# --- NVIDIA / GEMINI / GROQ (COMMENTED OUT — preserved for reference) --------
# The block below is kept but DISABLED. Do not uncomment unless switching back
# from local LLM. RAG/embedding pipeline still uses GEMINI via EMBEDDING_* above.
# NVIDIA is used for interview TTS only. Never commit real values.
# Get a key at https://build.nvidia.com (Generate API Key).
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Groq is used for Whisper STT only; it is not an interview reasoning fallback.
# Get a key at https://console.groq.com/keys. Never commit real values.
# Verify the model is currently supported: python scripts/verify_groq_model.py
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile
# Interview LLM resilience budgets (seconds).
# INTERVIEW_LLM_TIMEOUT_SECONDS=20
# INTERVIEW_LLM_TOTAL_BUDGET_SECONDS=75
# Interview TTS — NVIDIA-hosted voice, TEXT -> SPEECH only (server-side).
# NVIDIA_API_KEY never reaches the frontend — the browser only calls our
# FastAPI backend, which calls NVIDIA.
# Get a key at https://build.nvidia.com (Generate API Key). Never commit it.
# NVIDIA_API_KEY=your-nvidia-api-key
TTS_PROVIDER=nvidia
# Catalog TTS model/voice/function. Defaults target magpie-tts-multilingual
# (expressive conversational voice). If NVIDIA versions the function, update
# these from the function's API schema on build.nvidia.com — no code change.
# NVIDIA_TTS_MODEL=magpie-tts-multilingual
# NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
# NVIDIA_TTS_LANGUAGE=en-US
# NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
# Full invocation URL override (default built from the function id above):
# NVIDIA_TTS_ENDPOINT=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize
# NVIDIA_TTS_TIMEOUT_SECONDS=30
# Local-development diagnostics only: TTS_DEBUG=true adds safe provider facts
# (status/category/reason, never secrets) to backend logs and to the
# /interview/tts 503 response. Keep false/absent in production.
# TTS_DEBUG=true
# Manual provider probe (same endpoint/fields as the real provider, no pytest):
#   python scripts/nvidia_tts_probe.py
# Reads NVIDIA_API_KEY from the environment, prints status/content-type/size/
# elapsed (never the key), saves backend/tmp/nvidia_tts_test.wav on success.

# GitHub deep evidence inspection (server-side only; never expose to frontend)
# Use a read-only fine-grained token with public repository metadata/contents access.
# GITHUB_TOKEN=github_pat_...
