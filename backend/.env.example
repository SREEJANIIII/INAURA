# INAURA Backend — Environment Variables
# Copy to .env and fill with real values. Never commit .env

# Supabase — get these from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: JWT secret for local verification (from Supabase Auth settings)
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# API
API_V1_PREFIX=/api/v1

# Embeddings — Gemini (recommended), optional
# If not set, RAG falls back to deterministic keyword retrieval and app still starts.
# RAG pipeline: Gemini embeddings (768-d) → Supabase pgvector (HNSW) → retrieval_service
# Get a key at https://aistudio.google.com/apikey (same key as GOOGLE_API_KEY)
# Models: gemini-embedding-001 (768-d via outputDimensionality, default), text-embedding-004 (768-d, deprecated Jan 2026)
# Existing 1536-d OpenAI vectors MUST be re-embedded after switching providers (see supabase/016 migration + scripts/reembed_industry_knowledge.py)
# Example: EMBEDDING_PROVIDER=gemini, EMBEDDING_API_KEY=<Google API key>, EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_MODEL=gemini-embedding-001
# Optional: override output dimensionality (must match DB vector(768)). Default 768 via embedding_service.DIMENSION
# EMBEDDING_DIMENSION=768

# Experimental AI review (/ai-review-test only) — optional
# Get a key at https://aistudio.google.com/apikey. Never commit real values.
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
