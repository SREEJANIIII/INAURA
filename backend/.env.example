# INAURA Backend — Environment Variables
# Copy to .env and fill with real values. Never commit .env

# Supabase — get these from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: JWT secret for local verification (from Supabase Auth settings)
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# API
API_V1_PREFIX=/api/v1

# Embeddings — configurable, optional for Phase 4B
# If not set, RAG falls back to keyword retrieval and app still starts
# Example: EMBEDDING_PROVIDER=openai, EMBEDDING_API_KEY=sk-..., EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_MODEL=text-embedding-3-small

# Experimental AI review (/ai-review-test only) — optional
# Get a key at https://aistudio.google.com/apikey. Never commit real values.
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
